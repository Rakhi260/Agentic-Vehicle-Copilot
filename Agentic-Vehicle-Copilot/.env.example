# Copy to .env for local runs. On Render, set these in Dashboard -> Environment instead.
# Never commit the real .env file (it is already in .gitignore).

# Gemini key from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# Optional: force a specific model, e.g. gemini-3.5-flash
# GEMINI_MODEL=

# Optional: without it the weather agent uses Open-Meteo (no key needed)
OPENWEATHER_API_KEY=
